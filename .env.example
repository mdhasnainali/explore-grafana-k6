# ---------------------------------------------------------------------------
# Target under test
# ---------------------------------------------------------------------------
# Base URL of the API (no trailing slash)
BASE_URL=https://quickpizza.grafana.com

# Path of the endpoint to exercise
API_PATH=/api/quotes

# HTTP method: GET | POST | PUT | PATCH | DELETE
HTTP_METHOD=GET

# JSON request body (single line). Used for POST/PUT/PATCH.
REQUEST_BODY=

# Bearer token, sent as "Authorization: Bearer <token>" when set
AUTH_TOKEN=

# Extra headers as a JSON object, e.g. {"X-Api-Key":"abc","X-Tenant":"acme"}
EXTRA_HEADERS=

# ---------------------------------------------------------------------------
# Which test to run
# ---------------------------------------------------------------------------
# smoke | load | stress | spike | soak | ramping_arrival_rate | all
TEST_TYPE=smoke

# ---------------------------------------------------------------------------
# Thresholds (pass/fail criteria)
# ---------------------------------------------------------------------------
# Max p95 response time in ms
P95_MS=500
# Max p99 response time in ms
P99_MS=1000
# Max allowed request failure rate (0.01 = 1%)
ERROR_RATE=0.01

# ---------------------------------------------------------------------------
# Load shape overrides (all optional, sane defaults in scripts/lib/scenarios.js)
# ---------------------------------------------------------------------------
SMOKE_VUS=1
SMOKE_DURATION=30s

LOAD_VUS=50
LOAD_RAMP_UP=1m
LOAD_STEADY=3m
LOAD_RAMP_DOWN=1m

STRESS_MAX_VUS=300
STRESS_STEP=1m

SPIKE_BASE_VUS=10
SPIKE_PEAK_VUS=500

SOAK_VUS=50
SOAK_DURATION=1h

RAR_START_RATE=10
RAR_PEAK_RATE=200
RAR_TIME_UNIT=1s
# Leave RAR_PREALLOCATED_VUS / RAR_MAX_VUS unset to have them sized from
# RAR_PEAK_RATE automatically: an arrival-rate executor needs about
# rate x iteration-duration VUs, and under-allocating causes dropped_iterations.
# RAR_PREALLOCATED_VUS=400
# RAR_MAX_VUS=800

# Think time between iterations, in seconds
SLEEP_SECONDS=1

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
# Directory where reports are written (inside the container this is /results)
RESULTS_DIR=/results
# Tag written into every report so runs can be told apart
RUN_TAG=local

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
# UID/GID the k6 container runs as, so report files on the host stay writable.
# Match your own: `id -u` / `id -g`
K6_UID=1000
K6_GID=1000
